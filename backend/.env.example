# TradeAgent Configuration
# Copy this file to .env and fill in your values

# App
DEBUG=true

# Your products (for automated lead scanning)
DEFAULT_PRODUCT_KEYWORDS=embroidery thread, gold metallic yarn, gold thread, textile fabric
# Set SCAN_COUNTRIES empty to use global mode (15 countries)
DEFAULT_TARGET_COUNTRIES=Germany, United States, United Kingdom, France, Italy, Spain, Australia, India, Japan, South Korea, Brazil, Turkey, Netherlands, Canada, Mexico
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Ningbo, China

# Database (SQLite by default)
# DATABASE_URL=sqlite+aiosqlite:///./tradeagent.db

# SMTP Email (QQ Mail example)
# SMTP password: QQ Mail > Settings > Account > POP3/SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_USE_TLS=true

# LLM API (OpenAI-compatible: MiMo / DeepSeek / OpenAI)
# MiMo:     https://api.xiaomi.com/v1    model: mimo-v2.5
# DeepSeek: https://api.deepseek.com/v1  model: deepseek-chat
# OpenAI:   https://api.openai.com/v1    model: gpt-3.5-turbo
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
OPENAI_MODEL=mimo-v2.5

# --- GitHub Secrets for CI/CD ---
# Configure in GitHub repo > Settings > Secrets > Actions:
#   SMTP_USER = your QQ email (e.g. 2017059565@qq.com)
#   SMTP_PASSWORD = QQ SMTP authorization code (not login password)
#   REPORT_EMAIL = where to receive daily reports
#   OPENAI_API_KEY = MiMo API key for personalized email generation
#   OPENAI_BASE_URL = (optional) defaults to https://api.xiaomi.com/v1
#   OPENAI_MODEL = (optional) defaults to mimo-v2.5
