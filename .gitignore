# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
*.db
*.sqlite3
# SQLite in WAL mode: the write-ahead log and its shared-memory index, which sit
# beside the database file and are not reproducible state.
*.db-wal
*.db-shm

# Virtualenvs (all common names/spellings)
.venv/
venv/
env/
ENV/
.python-version

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated agent-run artefacts (reproduce with scripts/demo_agent_run.py)
artifacts/agent-demo/

# Self-probe reports (reproduce with scripts/self_probe.py)
artifacts/self-probe-*.json
# Interview-probe reports (reproduce with scripts/interview_probe.py)
artifacts/interview-*.md
artifacts/interview-*.json
# Contract-canary history (reproduce with scripts/contract_canary.py; CI uploads it)
artifacts/contract_canary/
# Quality-page screenshot (reproduce by opening /quality with the dev server)
artifacts/quality-page.png
# Page-by-page tour screenshots (reproduce by opening the app with the dev server)
artifacts/tour-*.png
# Layout measurements and per-width screenshots (reproduce with frontend/tests/browser/layout.mjs)
artifacts/ui/
# Screenshots the browser-flow runner writes on failure
frontend/tests/browser/*.png

# Agent work logs. These are this machine's session notes, not project state:
# useful locally, noise in a clone, and they name paths outside the repo.
.workbuddy/

# Environment
.env
*.env.local
.env.*
!.env.example

# Node
node_modules/
frontend/dist/
# The build the backend serves (npm run build:deploy). Generated, and large.
backend/webroot/
# Publish marker: binds this directory to the app behind its share link.
# Machine-local state, not part of the project -- but keep it on disk, or the
# next publish from here gets a different link.
*.genie

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
# Schema-migration backups: a copy of the database taken before a migration ran.
*.backup-*

# Screenshots from the one-off checks: the live site (npm run live:check) and
# the visual passes over the login page / empty states. Evidence, not artefacts.
frontend/live-*.png
frontend/shot-*.png
